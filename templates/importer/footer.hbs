<footer class="form-footer cji-footer">
  <p class="cji-status" aria-live="polite" hidden></p>
  {{#each buttons as |button|}}
  <button type="{{button.type}}" class="{{button.cssClass}}"
          {{#if button.action}}data-action="{{button.action}}"{{/if}}
          {{#if button.disabled}}disabled{{/if}}>
    {{#if button.icon}}<i class="{{button.icon}}" inert></i>{{/if}}
    <span>{{button.label}}</span>
  </button>
  {{/each}}
  {{#unless review}}
  <button type="button" data-action="cancelAnalysis" class="cji-cancel-analysis" hidden>
    <i class="fa-solid fa-ban" inert></i>
    <span>{{localize "compendium-json-importer.Button.CancelAnalysis"}}</span>
  </button>
  {{/unless}}
</footer>
