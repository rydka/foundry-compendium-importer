<section class="cji-summary" {{#unless review}}hidden{{/unless}}>
  {{#if review}}
  <h3>{{localize "compendium-json-importer.Summary.Title"}} <small>{{summary.target}}</small></h3>
  {{#if summary.pdf}}
  <section class="cji-pdf">
    <h4>{{localize "compendium-json-importer.Pdf.Title"}} <small>{{summary.pdf.fileName}}</small></h4>
    {{#if summary.pdf.problems.length}}
    <ul class="cji-list cji-pdf-problems">
      {{#each summary.pdf.problems}}
      <li class="cji-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> <strong>{{name}}</strong> <span class="cji-existing">{{page}}</span> — {{reason}}</li>
      {{/each}}
    </ul>
    {{/if}}
    <ul class="cji-counts">
      <li>{{localize "compendium-json-importer.Pdf.Pages" count=summary.pdf.pages seconds=summary.pdf.seconds}}</li>
      <li>{{localize "compendium-json-importer.Pdf.Blocks" found=summary.pdf.found read=summary.pdf.read}}{{#if summary.pdf.aiCount}} {{localize "compendium-json-importer.Pdf.BlocksAi" count=summary.pdf.aiCount}}{{/if}}</li>
      <li>{{localize "compendium-json-importer.Pdf.Items" count=summary.pdf.items}}</li>
      {{#each summary.pdf.ignored}}<li class="cji-warning">{{this}}</li>{{/each}}
    </ul>
    {{#if summary.pdf.blocks.length}}
    <details class="cji-pdf-blocks">
      <summary>{{localize "compendium-json-importer.Pdf.BlocksTitle" count=summary.pdf.blocks.length}}</summary>
      <ul class="cji-list">
        {{#each summary.pdf.blocks}}<li><strong>{{name}}</strong> <span class="cji-existing">{{page}}</span>{{#if ai}} <span class="cji-badge cji-badge-ai">{{localize "compendium-json-importer.Pdf.ReadByAi"}}</span>{{/if}}</li>{{/each}}
      </ul>
    </details>
    {{/if}}
    {{#if summary.pdf.itemList.length}}
    <details class="cji-pdf-items">
      <summary>{{localize "compendium-json-importer.Pdf.ItemsTitle" count=summary.pdf.itemList.length}}</summary>
      <ul class="cji-list">
        {{#each summary.pdf.itemList}}<li><strong>{{name}}</strong> <span class="cji-existing">{{page}}</span></li>{{/each}}
      </ul>
    </details>
    {{/if}}
  </section>
  {{/if}}
  <ul class="cji-counts">
    <li>{{localize "compendium-json-importer.Summary.Conform" count=summary.counts.conform}}</li>
    {{#unless summary.pdf}}<li>{{localize "compendium-json-importer.Summary.Updated" count=summary.counts.updated}}</li>{{/unless}}
    <li>{{localize "compendium-json-importer.Summary.Rejected" count=summary.counts.rejected}}</li>
    <li>{{localize "compendium-json-importer.Summary.Other" count=summary.counts.other}}</li>
    <li>{{localize "compendium-json-importer.Summary.ToReplace" count=summary.counts.toReplace}}</li>
  </ul>
  {{#if summary.enrich}}
  <h4>{{localize "compendium-json-importer.Enrich.Title"}}</h4>
  <ul class="cji-counts">
    <li>{{localize "compendium-json-importer.Enrich.Enriched" count=summary.enrich.counts.enriched}}</li>
    <li>{{localize "compendium-json-importer.Enrich.Unchanged" count=summary.enrich.counts.unchanged}}</li>
    <li>{{localize "compendium-json-importer.Enrich.NotEnriched" count=summary.enrich.counts.notEnriched}}</li>
  </ul>
  {{#each summary.enrich.skipped}}<p class="cji-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> {{this}}</p>{{/each}}
  {{#if summary.enrich.documents.length}}
  <div class="cji-list cji-enrich">
    {{#each summary.enrich.documents}}
    <details class="cji-enrich-{{status}}">
      <summary><strong>{{name}}</strong> <em>({{statusLabel}})</em></summary>
      <ul>
        {{#each reasons}}<li class="cji-warning">{{localize "compendium-json-importer.Enrich.Reverted" reason=this}}</li>{{/each}}
        {{#each lines}}<li>{{this}}</li>{{/each}}
      </ul>
      {{#if compendium.length}}
      <h5>{{localize "compendium-json-importer.Enrich.FromCompendium"}}</h5>
      <ul>
        {{#each compendium}}
        <li>
          <strong>{{name}}</strong> <span class="cji-existing">{{pack}}</span>
          <ul>{{#each adjusted}}<li>{{this}}</li>{{/each}}{{#each lines}}<li>{{this}}</li>{{/each}}</ul>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if notFound.length}}<p>{{localize "compendium-json-importer.Enrich.NotFound"}} {{#each notFound}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
      {{#if ambiguous.length}}<p class="cji-warning">{{localize "compendium-json-importer.Enrich.Ambiguous"}} {{#each ambiguous}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
      {{#if notAutomated.length}}
      <h5>{{localize "compendium-json-importer.Enrich.NotAutomated"}}</h5>
      <ul class="cji-not-automated">{{#each notAutomated}}<li>{{this}}</li>{{/each}}</ul>
      {{/if}}
    </details>
    {{/each}}
  </div>
  {{/if}}
  {{/if}}

  {{#each summary.warnings}}<p class="cji-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> {{this}}</p>{{/each}}

  {{#if summary.rejected.length}}
  <h4>{{localize "compendium-json-importer.Summary.RejectedTitle"}}</h4>
  <ul class="cji-list cji-rejected">
    {{#each summary.rejected}}
    <li>
      <strong>{{name}}</strong> <em>({{type}})</em>
      <ul>{{#each reasons}}<li>{{this}}</li>{{/each}}</ul>
    </li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if summary.notes.length}}
  <details class="cji-notes">
    <summary>{{localize "compendium-json-importer.Summary.NotesTitle" count=summary.notes.length}}</summary>
    <ul class="cji-list">
      {{#each summary.notes}}<li><strong>{{name}}</strong><ul>{{#each notes}}<li>{{this}}</li>{{/each}}</ul></li>{{/each}}
    </ul>
  </details>
  {{/if}}

  {{#if summary.conflicts.length}}
  <h4>{{localize "compendium-json-importer.Summary.ConflictsTitle"}}</h4>
  <p class="hint">{{localize "compendium-json-importer.Summary.ConflictsHint"}}</p>
  <div class="form-group">
    <label class="cji-select-all">
      <input type="checkbox" name="selectAll"> {{localize "compendium-json-importer.Summary.SelectAll"}}
    </label>
    <div class="form-fields">
      <select name="conflictAction">{{selectOptions summary.actions selected="replace"}}</select>
    </div>
  </div>
  <ul class="cji-list cji-conflicts">
    {{#each summary.conflicts}}
    <li>
      <label>
        <input type="checkbox" name="conflictSelected" value="{{id}}">
        <strong>{{name}}</strong> <em>({{type}})</em>
        <span class="cji-existing">{{localize "compendium-json-importer.Summary.Existing" name=existing}}</span>
      </label>
    </li>
    {{/each}}
  </ul>
  {{/if}}
  {{/if}}
</section>
